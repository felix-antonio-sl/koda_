# KODA Framework .gitignore

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE/Editor (configs locales)
.idea/
*.swp
*.swo
*~
.project
.settings/

# IDE Adapters (locales a cada desarrollador, no versionados)
.agent/
.windsurf/
.cursor/

# Antigravity session artifacts (local only)
.antigravity/

# Node.js (for validation tools)
node_modules/
npm-debug.log
yarn-error.log

# Python (for validation tools)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/

# Staging/WIP files (local only, except .gitkeep)
staging/*
!staging/.gitkeep
*.wip.yml
*.wip.yaml
*.draft.yml
*.draft.yaml

# Local overrides
.local/
*.local.yml
*.local.yaml

# Machine-specific resolver override
.knowledge-resolver.local.yml

# Secrets (never commit)
.env
.env.*
secrets/
*.key
*.pem

# Logs
logs/
*.log

# Build artifacts
dist/
build/
*.min.js

# Test outputs
coverage/
.nyc_output/
test-results/

# Backup files
*.bak
*.backup
*.old

# Temporary files
tmp/
temp/
*.tmp
.claude/
.agent/
.antigravity/
sources/eliminar/
